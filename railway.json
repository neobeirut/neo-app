{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/web/**",
      "/railway.json",
      "/nixpacks.toml",
      "/.railwayignore",
      "/package.json",
      "/package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "cd web && npm run start"
  }
}
