{
  "cleanUrls": true,
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/tablet-punch-pwa$", "dest": "/tablet-punch-pwa/" },
    { "src": "^/tablet-punch-pwa/(.*)", "dest": "/tablet-punch-pwa/$1" },
    { "src": "^/sw.js$", "dest": "/sw.js", "headers": { "cache-control": "no-cache, no-store, must-revalidate" } },
    { "src": "^/manifest.json$", "dest": "/manifest.json" },
    { "src": "^/icons/(.*)", "dest": "/icons/$1" },
    { "src": "^/icon.png$", "dest": "/icon.png" },
    { "src": "^/favicon.png$", "dest": "/favicon.png" },
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/privacy-policy(/.*)?$", "dest": "/privacy-policy.html" },
    { "src": "^/privacy(/.*)?$", "dest": "/privacy.html" },
    { "src": "^/style.css$", "dest": "/style.css" },
    { "src": "^/flow-logo.png$", "dest": "/flow-logo.png" },
    { "src": "^/api/(.*)", "dest": "https://gregarious-curiosity-production-653f.up.railway.app/api/$1" },
    { "src": "^/admin(/.*)?$", "dest": "/admin/index.html" },
    { "src": "^/login(/.*)?$", "dest": "/admin/index.html" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
