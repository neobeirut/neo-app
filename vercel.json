{
  "cleanUrls": true,
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/assets/(.*)", "dest": "/assets/$1" },
    { "src": "^/privacy-policy(/.*)?$", "dest": "/privacy-policy.html" },
    { "src": "^/privacy(/.*)?$", "dest": "/privacy.html" },
    { "src": "^/style.css$", "dest": "/style.css" },
    { "src": "^/flow-logo.png$", "dest": "/flow-logo.png" },
    { "src": "^/api/(.*)", "dest": "https://gregarious-curiosity-production-653f.up.railway.app/api/$1" },
    { "src": "^/admin(/.*)?$", "dest": "/admin/index.html" },
    { "src": "^/login(/.*)?$", "dest": "/admin/index.html" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
