{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://app.neobeirut.com/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://app.neobeirut.com/admin/:path*",
      "permanent": false
    }
  ],
  "routes": [
    { "src": "/admin/(.*)", "dest": "https://app.neobeirut.com/admin/$1" },
    { "src": "/(?!assets/.*|admin/.*).*", "dest": "/index.html" }
  ]
}
